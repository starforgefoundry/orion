+ * @param {number} offset
+ * @param {number} length
+ * @returns {AsyncGenerator<Uint8Array<ArrayBuffer>, void, void>}
+ */
+async function* read_range(get_chunk, offset, length) {
+	let chunk_start = 0;
+	for (let index = 0; ; index++) {
+		const chunk = await get_chunk(index);
+		if (!chunk) return;
