{
  "name": "orion",
  "private": true,
  "version": "0.28.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "pnpm run build && node --env-file=.env build",
    "start": "node build",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts"
  },
  "devDependencies": {
    "@auth/core": "^0.41.1",
    "@auth/sveltekit": "^1.11.1",
    "@castlenine/svelte-qrcode": "^2.3.0",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.57.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.4",
    "@types/opentype.js": "^1.3.10",
    "barqode": "^0.0.2",
    "bits-ui": "^2.18.0",
    "cn": "^0.4.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-valibot": "^0.4.2",
    "earcut": "^3.2.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.1",
    "globals": "^16.5.0",
    "jszip": "^3.10.1",
    "luxon": "^3.7.2",
    "mode-watcher": "^1.1.0",
    "mqtt": "^5.15.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "qrcode-generator": "^2.0.4",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.54.0",
    "svelte-check": "^4.3.5",
    "svelte-highlight": "^7.9.0",
    "svelte-sonner": "^1.2.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "valibot": "^1.2.0",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "passkit-generator": "3.6.1",
    "postgres": "^3.4.9",
    "square": "^43.2.1"
  }
}
