DATABASE_URL=postgres://orion:orion@localhost:5432/orion
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""

# Dev server only: signs everyone in as this staff user, skipping Google. `pnpm db:seed` creates it.
DEV_LOGIN_EMAIL=""

# Google Calendar service account used to host per-teacher class calendars.
# Create a service account in the same Google Cloud project that owns the OAuth
# credentials above and enable the Google Calendar API for it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The private_key field from the service account JSON. Newlines may be escaped
# as "\n" when stored on a single line (the app un-escapes them at runtime).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Directory uploaded files are stored in. Mount a persistent volume here in production.
STORAGE_DIR="storage"
# Signs expiring links to waivers and print request files.
FILE_SIGNING_SECRET=""

SQUARE_TOKEN=""
# Use https://connect.squareupsandbox.com for the Square sandbox
SQUARE_URL="https://connect.squareup.com"
SQUARE_APPLICATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""

MAILGUN_API_KEY=""

# Public URL. Square webhooks must be subscribed to $FRONTEND_URL/api/square/webhook.
FRONTEND_URL="https://orion.example.com"

PUBLIC_PRINT_REQUEST_EMAIL="3dprint@example.com"

# adapter-node runtime settings. ORIGIN must match the public URL or form submissions are rejected.
ORIGIN="https://orion.example.com"
# Must be at least the print request upload limit in settings.
BODY_SIZE_LIMIT="1G"
TZ="UTC"
