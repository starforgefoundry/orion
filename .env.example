DATABASE_URL=file:local.db
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
AUTH_SECRET=""

# Google Calendar service account used to host per-teacher class calendars.
# Create a service account in the same Google Cloud project that owns the OAuth
# credentials above and enable the Google Calendar API for it.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# The private_key field from the service account JSON. Newlines may be escaped
# as "\n" when stored on a single line (the app un-escapes them at runtime).
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

S3_PUBLIC_URL=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_APPLICATION_KEY=""
# Public base URL objects are served from. Prepended at runtime to the object
# keys stored in the database (e.g. https://data.example.com).
S3_PUBLIC_URL=""

SQUARE_TOKEN=""
SQUARE_URL=""
SQUARE_APPLICATION_ID=""
SQUARE_WEBHOOK_SIGNATURE_KEY=""
SQUARE_WEBHOOK_NOTIFICATION_URL="https://orion.example.com/api/square/webhook"

MAILGUN_API_KEY=""

FRONTEND_URL="https://orion.example.com"

PUBLIC_ENV="dev" # controls wether to use Square sandbox or production environment
PUBLIC_PRINT_REQUEST_EMAIL="3dprint@example.com"